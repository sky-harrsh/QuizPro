# Ensure shell scripts and Docker files always use LF line endings on all OS platforms
*.sh        text eol=lf
*.bat       text eol=crlf
Dockerfile  text eol=lf
*.java      text eol=lf
*.jsp       text eol=lf
*.xml       text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
*.properties text eol=lf
*.json      text eol=lf
*.jar       binary
*.war       binary
*.class     binary
